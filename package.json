{
  "name": "slow-dough-pizza-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "test:e2e": "node --experimental-strip-types tests/e2e/cms-workflow.test.mjs",
    "check": "npm run lint && npm run validate:content && npm run build",
    "test:e2e:setup": "playwright install chromium"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@sveltia/cms": "^0.221.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
